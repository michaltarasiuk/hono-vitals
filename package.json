    "clsx": "^2.1.1",
    "hono": "^4.12.27",
    "honox": "^0.1.58",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0",
    "waddler": "^0.1.1",
    "web-vitals": "^5.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hono/vite-build": "^1.11.1",
    "@types/bun": "1.3.14",
